<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="002-add-fcm-token-to-users" author="beesure">
        <comment>Ajouter les champs FCM token pour les notifications push</comment>

        <addColumn tableName="users">
            <column name="fcm_token" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <addColumn tableName="users">
            <column name="fcm_token_updated_at" type="TIMESTAMP">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <rollback>
            <dropColumn tableName="users" columnName="fcm_token"/>
            <dropColumn tableName="users" columnName="fcm_token_updated_at"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
